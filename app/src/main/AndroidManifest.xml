<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions are declared here as a reference map even if not yet requested at runtime.
      They are COMMENTED OUT until the feature that needs them is built, so the app never
      holds permissions it doesn't use — per AGENTS.md "treat every permission as revocable."

      Future permissions (see PROJECT_BRIEF.md §3 for context):
      <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
          tools:ignore="ProtectedPermissions" />         ← M3: usage stats reader
      <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />  ← M4: overlay
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />   ← M3: notifications (API 33+)
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />   ← M2: focus service
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" /> ← M2: type
      <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" /> ← M4: re-arm blocking
    -->

    <application
        android:name=".FocusFlowApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusFlow"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <!--
              enableOnBackInvokedCallback = true: opts into predictive back (Android 13+).
              Required for Android 16 where predictive back is on by default.
              Per PROJECT_BRIEF.md: "Respect predictive back."
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
