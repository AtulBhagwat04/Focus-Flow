rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and gamification document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Focus sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // Settings and backup subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Friends subcollection
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Focus rooms
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostUserId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.hostUserId == request.auth.uid;
    }

    // Leaderboards (weekly standings)
    match /leaderboards/{boardId}/entries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(entryId);
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
