# FocusFlow Environment Configuration Template
# Copy this file to '.env' and fill in your actual private credentials.
# NOTE: The '.env' file is ignored by Git and will NEVER be pushed publicly.

# ==============================================================================
# YouTube Data API v3 (Used for YouTube Study Mode & Educational Channel Picker)
# Obtain from: https://console.cloud.google.com/apis/credentials
# ==============================================================================
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# ==============================================================================
# Firebase Configuration & Debug Secrets
# ==============================================================================
FIREBASE_PROJECT_ID=focusflow-app
FIREBASE_APP_CHECK_DEBUG_TOKEN=your_app_check_debug_token_here
FIREBASE_WEB_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# ==============================================================================
# Google Play Billing & Licensing (Optional)
# ==============================================================================
PLAY_BILLING_PUBLIC_KEY=your_play_billing_public_key_here

# ==============================================================================
# App Release Signing Keys (Store path or passwords locally if not using keystore)
# ==============================================================================
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
