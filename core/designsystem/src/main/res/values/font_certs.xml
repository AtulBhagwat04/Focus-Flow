<?xml version="1.0" encoding="utf-8"?>
<!--
    Required certificate set for the Google Fonts downloadable-font provider.
    The com.google.android.gms.fonts authority performs a certificate check at
    runtime to prevent font-provider spoofing. Both debug and production
    certificates from GMS are included so the font loads in all build types.

    Source: https://developer.android.com/develop/ui/views/text-and-emoji/downloadable-fonts
-->
<resources>
    <!-- Debug certificate (used by Android Studio emulators and debug builds) -->
    <array name="com_google_android_gms_fonts_certs_dev">
        <item></item>
    </array>

    <!-- Production certificate (used by release builds on real devices / Play store) -->
    <array name="com_google_android_gms_fonts_certs_prod">
        <item></item>
    </array>

    <!-- Combined array referenced by GoogleFont.Provider certificates param -->
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
</resources>
